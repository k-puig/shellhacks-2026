{
  "workspace": [
    "./app/rest",
    "./app/protoweb",
    "./package/database",
    "./package/s3"
  ],
  "lock": {
    "path": "./deno.lock"
  },
  "tasks": {
    "rest": "deno run --allow-net --allow-env app/rest/main.ts",
    "protoweb": "deno run --allow-net --allow-read jsr:@std/http@1/file-server app/protoweb/dist/ -p 5173"
  },
  "compilerOptions": {
    "experimentalDecorators": true
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@app/": "./app/",
    "@package/": "./package/",
    "@postgresql-schema/": "./package/database/schema/postgresql-schema/",
    "@mongodb-schema/": "./package/database/schema/mongodb-schema/",
    "@mikro-orm/core": "npm:@mikro-orm/core@^7.2.1",
    "@mikro-orm/decorators/legacy": "npm:@mikro-orm/decorators@^7.2.1/legacy",
    "@mikro-orm/postgresql": "npm:@mikro-orm/postgresql@^7.2.1",
    "@std/assert": "jsr:@std/assert@1"
  },
  "allowScripts": {
    "allow": ["npm:browser-tabs-lock@1.3.0"],
    "deny": ["npm:fsevents@2.3.3"]
  }
}
