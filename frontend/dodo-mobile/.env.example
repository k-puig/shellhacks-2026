# Copy to .env.local (git-ignored) and fill in. Restart Metro with -c after changes.

# Open straight to Home without Auth0 (remove to require login)
EXPO_PUBLIC_SKIP_LOGIN=1

# Auth0 (needed when SKIP_LOGIN is off). Use the "DODO Mobile" Native app's
# Client ID, not the website's: the website app needs a secret the phone can't hold.
EXPO_PUBLIC_AUTH0_DOMAIN=dodocall.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=
# Identifier of the Auth0 API the backend checks tokens against. Must match the
# backend's AUTH0_API_AUDIENCE exactly (trailing slash included).
EXPO_PUBLIC_AUTH0_AUDIENCE=https://dodo.gay/

# DODO backend origin, without /api/v1 (https://dodo.gay for the live server).
# Leave empty to use the app offline only (no account sync).
EXPO_PUBLIC_API_URL=https://dodo.gay

# Voice questions and smart highlights
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=

# Narration
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=

# Optional: sign iOS builds with your own Apple account (overrides app.json)
DODO_IOS_BUNDLE_ID=
DODO_APPLE_TEAM_ID=
