{
  "expo": {
    "name": "dodo-mobile",
    "slug": "dodo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dodomobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.duranmichael681.dodo-mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSSpeechRecognitionUsageDescription": "DODO turns your voice commands into actions like highlighting and notes.",
        "NSMicrophoneUsageDescription": "DODO listens for \"Hey DODO\" so you can control your book hands-free."
      },
      "appleTeamId": "A4A5WJGF36"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15131C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DODO listens for \"Hey DODO\" so you can control your book hands-free.",
          "speechRecognitionPermission": "DODO turns your voice commands into actions like highlighting and notes."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "./plugins/withIosSceneLifecycle"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
